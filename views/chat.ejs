<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat</title>
    <link rel="stylesheet" href="/css/chat.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<body>

    <div class="app">

        <%- include("partials/chatSideBar", { chatList, getUserShortName, getRandomColor }) %>

        <!-- ───────────── CHAT AREA ───────────── -->
        <main class="chat-area" id="chatArea">

            <!-- Empty State -->
            <div class="empty-state" id="emptyState">
                <i class="fa-solid fa-comments fa-3x"></i>
                <h2>Your messages</h2>
                <p>Select a chat from the list, or click the <i class="fa-solid fa-pen-to-square"></i> icon in the
                    top-left to start a new conversation.</p>
            </div>

            <!-- Chat Window (hidden by default) -->
            <div class="chat-window hidden" id="chatWindow">

                <!-- Chat Header -->
                <div class="chat-header">
                    <div class="chat-header-info">
                        <div class="avatar sm">JD</div>
                        <div>
                            <div class="chat-header-name">John Doe</div>
                            <div class="chat-header-status">
                                <span class="online-dot"></span> Online
                            </div>
                        </div>
                    </div>
                    <div class="chat-header-actions">
                        <button class="icon-btn tooltip" id="addMemberBtn" data-tip="Add members">
                            <i class="fa-solid fa-user-plus"></i>
                        </button>
                        <button class="icon-btn tooltip" data-tip="Search in chat">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                        <button class="icon-btn tooltip" data-tip="More options">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                    </div>
                </div>

                <!-- Messages -->
                <div class="messages" id="messages">
                    <div class="date-divider"><span>Today</span></div>

                    <div class="message received">
                        <div class="avatar xs">JD</div>
                        <div class="message-body">
                            <span class="message-sender">John Doe</span>
                            <div class="bubble">Hey! Are you free today?</div>
                            <span class="message-time">10:32 AM</span>
                        </div>
                    </div>

                    <div class="message sent">
                        <div class="message-body">
                            <div class="bubble">Yeah, what's up?</div>
                            <span class="message-time">10:33 AM</span>
                        </div>
                    </div>

                    <div class="message received">
                        <div class="avatar xs">JD</div>
                        <div class="message-body">
                            <span class="message-sender">John Doe</span>
                            <div class="bubble">Can we hop on a quick call? Need to discuss the sprint.</div>
                            <span class="message-time">10:34 AM</span>
                        </div>
                    </div>

                    <div class="message sent">
                        <div class="message-body">
                            <div class="bubble">Sure, give me 5 mins!</div>
                            <span class="message-time">10:35 AM</span>
                        </div>
                    </div>
                </div>

                <!-- Input Box -->
                <div class="input-area">
                    <button class="icon-btn attach-btn tooltip" data-tip="Attach file">
                        <i class="fa-solid fa-paperclip"></i>
                    </button>
                    <div class="input-wrapper">
                        <textarea id="messageInput" placeholder="Type a message..." rows="1"></textarea>
                    </div>
                    <button class="icon-btn emoji-btn tooltip" data-tip="Emoji">
                        <i class="fa-regular fa-face-smile"></i>
                    </button>
                    <button class="send-btn tooltip" id="sendBtn" data-tip="Send (Enter)">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>

            </div>

        </main>

    </div>

    <%- include('partials/newChatModal', { users: users, getUserShortName, getRandomColor }) %>

        <script src="/socket.io/socket.io.js"></script>
        <script src="/js/socket.js"></script>
        <script src="/js/sidebar.js"></script>
        <script src="/js/modal.js"></script>
        <script src="/js/messages.js"></script>
</body>

</html>