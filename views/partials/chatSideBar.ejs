<!-- ───────────── SIDEBAR ───────────── -->
<aside class="sidebar">

    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <button class="icon-btn tooltip" id="sidebarToggle" data-tip="Toggle sidebar">
            <i class="fa-solid fa-bars"></i>
        </button>
        <div class="sidebar-logo">
            <i class="fa-solid fa-comments"></i>
            <span class="sidebar-text">ChatApp</span>
        </div>
        <button class="icon-btn tooltip sidebar-text" id="newChatBtn" data-tip="New conversation">
            <i class="fa-solid fa-pen-to-square"></i>
        </button>
    </div>

    <!-- Search -->
    <div class="search-wrapper sidebar-text">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" placeholder="Search chats or users..." />
    </div>

    <!-- Tabs -->
    <div class="sidebar-tabs sidebar-text">
        <button class="tab active" data-tab="chats">Chats</button>
        <button class="tab" data-tab="users">People</button>
    </div>

    <!-- Chat List -->
    <div class="tab-content active sidebar-text" id="tab-chats">
        <ul class="chat-list" id="chatList">
            <% chatList.forEach((item) => { %>
                <li class="chat-item active" data-chat-id="<%= item._id %>">
                    <% item?.participants?.forEach((user) => { %>
                        <div class="avatar"><%= getUserShortName(user?.name) %></div>
                    <% }) %>
                    <div class="chat-info">
                        <div class="chat-meta">
                            <% item?.participants?.forEach((user) => { %>
                                <span class="chat-name"><%= user?.name %></span>
                            <% }) %>
                                <span class="chat-time">2m ago</span>
                        </div>
                        <% if(item?.lastMessage) { %>
                            <div class="chat-meta">
                                <span class="chat-preview"><%= item?.lastMessage %></span>
                                <span class="badge">3</span>
                            </div>
                        <% } %>
                    </div>
                </li>
            <% }) %>
